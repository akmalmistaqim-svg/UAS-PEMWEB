{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/api/frontend/(.*)\\.php",
      "dest": "/api/frontend/$1.php"
    },
    {
      "src": "/api/backend/(.*)\\.php",
      "dest": "/api/backend/$1.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}